#!/usr/bin/ucode
// SPDX-License-Identifier: GPL-2.0-only

'use strict';

let ctl = require('chanmgr.controller');
let agent = require('chanmgr.agent');
let guard = require('chanmgr.guard');

function usage() {
	warn(
		'Usage: chanmgr <command> [options]\n\n' +
		'Commands:\n' +
		'  status                  Print the last evaluation (JSON)\n' +
		'  discover [--json]       Query all nodes and list their radios\n' +
		'  sample                  Take one channel-utilization sample\n' +
		'  evaluate [--apply|--dry-run] [--no-gap]\n' +
		'                          Scan, plan and (in apply mode) switch\n' +
		'  apply [2g|5g]           Apply the latest plan now, ignoring hysteresis\n' +
		'  daemon                  Run the scheduler (used by the init script)\n' +
		'  agent info|survey       Local agent queries\n' +
		'  agent scan <radio>\n' +
		'  agent switch <radio> <channel> [width] [--csa]\n' +
		'                          Switch a local radio now. Radios with mesh get a\n' +
		'                          guarded restart: back to the old channel unless the\n' +
		'                          radio and its mesh peers come back within 90 s\n' +
		'  agent status <radio>    State of the last guarded switch\n' +
		'  agent recover           Undo unfinished switches (run at boot)\n\n' +
		'Set CHANMGR_VERBOSE=1 to also print log messages.\n'
	);

	exit(1);
}

let args = ARGV, cmd = shift(args);
let has = (f) => index(args, f) >= 0;
let out = (v) => print(sprintf('%.J\n', v));

switch (cmd) {
case 'status':
	out(ctl.status());
	break;

case 'discover':
	let found = ctl.discover();

	if (has('--json')) {
		out(found);
		break;
	}

	for (let name, r in found) {
		if (r.error) {
			print(sprintf('%s: ERROR %s\n', name, r.error));
			continue;
		}

		print(sprintf('%s (%s)\n', name, r.data.hostname));

		for (let radio, d in r.data.radios)
			print(sprintf('  %s/%s  %s  channel %d  %d MHz  %s  [%s]%s\n',
				name, radio, d.band, d.channel, d.width, d.htmode,
				join(', ', map(d.ifaces, (i) => i.ifname + ':' + i.mode)),
				d.has_mesh ? '  mesh: put it in a group or it stays locked' : ''));

		for (let radio, why in r.data.down ?? {})
			print(sprintf('  %s/%s  DOWN: %s\n', name, radio, why));
	}

	break;

case 'sample':
	out(ctl.sample());
	break;

case 'evaluate':
	out(ctl.evaluate({
		apply: has('--apply') ? true : has('--dry-run') ? false : null,
		nogap: has('--no-gap')
	}));
	break;

case 'apply':
	out(ctl.apply(args[0]));
	break;

case 'daemon':
	ctl.daemon();
	break;

case 'agent':
	switch (shift(args)) {
	case 'info': out(agent.info()); break;
	case 'survey': out(agent.survey()); break;
	case 'scan': out(agent.scan(args[0])); break;
	case 'switch':
		if (!args[0] || !args[1])
			usage();

		let width = +(match(args[2] ?? '', /^[0-9]+$/) ? args[2] : 0);

		// radios with a mesh interface: guarded restart, rolled back unless
		// the radio and its mesh peers come back (no controller involved)
		if (agent.info().radios[args[0]]?.has_mesh && !has('--csa')) {
			let r = guard.start({ radio: args[0], channel: args[1], width, delay: 1, confirm_timeout: 0 });

			out(r);

			if (r.ok)
				print(sprintf('Guarded switch started. Follow it with: chanmgr agent status %s\n', args[0]));

			break;
		}

		out(agent.switch_channel({ radio: args[0], channel: +args[1], width, method: 'csa' }));
		break;

	case 'status':
		out(guard.status(args[0]));
		break;

	case 'guard': {
		// internal: the background part of a guarded switch
		let a = { radio: args[0] };

		for (let kv in slice(args, 1)) {
			let m = match(kv, /^([a-z_]+)=(-?[0-9]+)$/);

			if (m)
				a[m[1]] = +m[2];
		}

		out(guard.run(a));
		break;
	}

	case 'recover':
		out(guard.recover());
		break;
	default: usage();
	}
	break;

default:
	usage();
}
