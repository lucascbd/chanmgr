#!/bin/sh
# Test stand-in for iw: one 5 GHz radio (phy#1) with phy1-ap0 and phy1-mesh0.
#   $CHANMGR_RUN_DIR/freq       current frequency, or "down" (default 5180)
#   $CHANMGR_RUN_DIR/peers      established mesh peers (default 1)
#   $CHANMGR_RUN_DIR/peers_ttl  if present: station dumps left before peers drop to 0
d=$CHANMGR_RUN_DIR
[ -f "$d/freq" ] || echo 5180 > "$d/freq"
[ -f "$d/peers" ] || echo 1 > "$d/peers"
freq=$(cat "$d/freq")
case "$*" in
"dev phy1-ap0 info"|"dev phy1-mesh0 info")
	[ "$freq" = down ] && exit 1
	ch=$(( (freq - 5000) / 5 ))
	printf 'Interface %s\n\taddr 02:00:00:00:00:01\n\twiphy 1\n\tchannel %d (%d MHz), width: 20 MHz, center1: %d MHz\n' "$2" "$ch" "$freq" "$freq";;
"dev phy1-mesh0 station dump")
	[ "$freq" = down ] && exit 1
	if [ -f "$d/peers_ttl" ]; then
		t=$(cat "$d/peers_ttl"); t=$((t - 1)); echo $t > "$d/peers_ttl"
		[ $t -le 0 ] && echo 0 > "$d/peers"
	fi
	n=$(cat "$d/peers"); i=0
	while [ $i -lt "$n" ]; do printf 'Station 56:af:97:40:a0:4%d (on phy1-mesh0)\n\tmesh plink:\tESTAB\n' $i; i=$((i + 1)); done;;
"phy#1 info")
	printf '\t\t\t* 5180.0 MHz [36] (23.0 dBm)\n\t\t\t* 5745.0 MHz [149] (30.0 dBm)\n';;
"dev phy1-mesh0 switch"*)
	echo "$*" >> "$d/iw.log";;
*) exit 1;;
esac
