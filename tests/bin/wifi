#!/bin/sh
# Test stand-in for wifi. "reload"/"up" take the next line of
# $CHANMGR_RUN_DIR/next ("<freq|down> [peers]"); the last line stays.
d=$CHANMGR_RUN_DIR
echo "wifi $*" >> "$d/iw.log"
case "$1" in
reload|up)
	[ -f "$d/next" ] || exit 0
	set -- $(head -n 1 "$d/next")
	echo "$1" > "$d/freq"
	[ -n "$2" ] && echo "$2" > "$d/peers"
	[ "$(wc -l < "$d/next")" -gt 1 ] && sed -i 1d "$d/next";;
down) echo down > "$d/freq";;
esac
exit 0
